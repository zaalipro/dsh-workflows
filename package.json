{
  "name": "@zaalipro/dsh-workflows",
  "version": "0.1.0-rc.1",
  "description": "Installable saved-workflow and supervised-run product for DeepSeek Harness",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "lib",
    "dist",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "README.i18n.yaml",
    "LICENSE",
    "NOTICE.md",
    "package.json",
    "tsconfig.client.json"
  ],
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./registry": {
      "types": "./lib/registry/index.d.ts",
      "default": "./lib/registry/index.js"
    },
    "./supervisor": {
      "types": "./lib/supervisor/index.d.ts",
      "default": "./lib/supervisor/index.js"
    },
    "./run-recorder": {
      "types": "./lib/run-recorder.d.ts",
      "default": "./lib/run-recorder.js"
    },
    "./user-questions": {
      "types": "./lib/user-questions.d.ts",
      "default": "./lib/user-questions.js"
    },
    "./commands": {
      "types": "./lib/commands/index.d.ts",
      "default": "./lib/commands/index.js"
    },
    "./tool": {
      "types": "./lib/tool/index.d.ts",
      "default": "./lib/tool/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./types": {
      "types": "./lib/types.d.ts",
      "default": "./lib/types.js"
    },
    "./invariant": {
      "types": "./lib/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./typert": {
      "types": "./lib/typert.d.ts",
      "default": "./lib/typert.js"
    },
    "./remote": {
      "types": "./lib/remote.d.ts",
      "default": "./lib/remote.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./skills/create-workflow/SKILL.md": "./skills/create-workflow/SKILL.md",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "typecheck:host": "tsc -p tsconfig.host.json --noEmit",
    "typecheck": "tsc -b --pretty false",
    "test:unit": "vitest run",
    "test": "vitest run",
    "build": "node scripts/build.mjs",
    "verify:package": "node scripts/verify-package.mjs --source .",
    "verify:docs": "node scripts/verify-docs.mjs",
    "doc-sync": "node scripts/verify-docs.mjs",
    "prepare": "node scripts/build.mjs",
    "check:release": "node scripts/check-release.mjs"
  },
  "dependencies": {
    "fs-native-extensions": "1.5.0",
    "zod": "^4.0.0",
    "@deepseek-ai/schemastery": "3.18.1",
    "chokidar": "^4.0.0",
    "clsx": "^2.1.1",
    "tar": "^7.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.1.0-rc.8",
    "@deepseek-ai/dsh-api-remotes": ">=0.1.0-rc.8",
    "@deepseek-ai/dsh-commands": ">=0.1.0-rc.8",
    "@deepseek-ai/dsh-fs": ">=0.1.0-rc.8",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.8",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.8",
    "@deepseek-ai/dsh-skill": ">=0.1.0-rc.8",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.8",
    "@deepseek-ai/dsh-user-questions": ">=0.1.0-rc.8",
    "@deepseek-ai/dsh-workflow": ">=0.1.0-rc.8",
    "@deepseek-ai/dsh-workflow-worker-thread": ">=0.1.0-rc.8",
    "@deepseek-ai/dsh-client-connection": ">=0.1.0-rc.8",
    "react": ">=18.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0",
    "tsx": "^4.19.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@deepseek-ai/dsh-client-connection": "0.1.0-rc.8"
  },
  "dsh": {
    "compatibility": {
      "release": "H",
      "reject": [
        "0.1.0-rc.8"
      ],
      "verifiedLaterReleases": []
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    }
  }
}
