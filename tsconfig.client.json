{
  "compilerOptions": {
    "target": "ES2024", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "skipLibCheck": true, "jsx": "react-jsx",
    "rootDir": "src/client", "outDir": "lib/client-types", "declaration": true,
    "declarationMap": true, "composite": true, "incremental": true,
    "sourceMap": true, "lib": ["ES2024", "DOM", "DOM.Iterable"], "types": ["node"]
  },
  "include": ["src/client/**/*.ts", "src/client/**/*.tsx", "src/client/**/*.d.ts"],
  "exclude": ["tests", "node_modules"]
}
